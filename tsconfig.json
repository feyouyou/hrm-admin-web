{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["ES2025", "DOM"],
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": {
      "@src/*": ["./src/*"],
      "@common/*": ["./src/common/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
